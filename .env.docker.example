# docker compose --env-file .env.docker -p <slug> up -d --build
# 多模板並存時 COMPOSE_SLUG / APP_PORT / DB_PORT 要各自不同
COMPOSE_SLUG=tu33
APP_PORT=3000
DB_PORT=55433
DB_NAME=erp_demo
DB_PASSWORD=postgres
# 必填：openssl rand -hex 32
JWT_SECRET=
# true = 灌匿名 demo 資料（已有資料會略過）
SEED_DEMO=true
# demo 租戶顯示名稱（匿名，不可用真實客戶名）
DEMO_TENANT_NAME=示範公司
# 選填：要測 LINE 時才填
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
